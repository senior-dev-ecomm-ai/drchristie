{% schema %}
	{
	  "name": "Footer",
	  "tag": "footer",
	  "class": "site-footer bg:bordeaux",
	  "settings": [
	  	{
	  		"type" : "text",
	  		"id" : "signup_text",
	  		"label": "Sign Up Text"
	  	}
	  ]
	}
{% endschema %}