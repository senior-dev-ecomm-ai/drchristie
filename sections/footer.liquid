<div class="site-footer__upper wrap flex spacious">
	<div class="site-footer__left">
		<h2 class="colour:base-white uppercase text:heading-s font:medium">Newsletter</h2>
		{% if section.settings.signup_text != blank %}
			<p class="colour:base-white text:body-m font:regular">{{ section.settings.signup_text }}</p>
		{% endif %}
		<div class="site-footer__newsletter">
			<div class="klaviyo-form-RZNjKH"></div>
			<p><small>*By signing up, you consent to receive Dr. Christie’s emails.</small></p>
		</div>
		<div class="mobile">
			<ul class="flex">
				{% for link in linklists.connect.links %}
					<li class="social-link">
				      <a class="font:regular text:body-m colour:base-white" href="{{ link.url }}"><span class="screen-reader-text">{{ link.title }}</span></a>
					</li>
				{% endfor %}
			</ul>			
		</div>
	</div>
	<div class="site-footer__right">
		<nav class="site-footer__nav flex">
			<div class="site-footer__nav-section">
				<h2 class="colour:base-white uppercase text:heading-s font:medium site-footer__trigger">Practice</h2>
				<ul>
					{% for link in linklists.clinic.links %}
						<li>
					      <a class="font:regular text:body-m colour:base-white" href="{{ link.url }}"><span>{{ link.title }}</span></a>
						</li>
					{% endfor %}
				</ul>
			</div>
			<div class="site-footer__nav-section">
				<h2 class="colour:base-white uppercase text:heading-s font:medium">Services</h2>
				<ul>
					{% for link in linklists.services.links %}
						<li>
					      <a class="font:regular text:body-m colour:base-white" href="{{ link.url }}"><span>{{ link.title }}</span></a>
						</li>
					{% endfor %}
				</ul>
			</div>
			<div class="site-footer__nav-section desktop">
				<h2 class="colour:base-white uppercase text:heading-s font:medium">Connect</h2>
				<ul>
					{% for link in linklists.connect.links %}
						<li>
					      <a class="font:regular text:body-m colour:base-white" href="{{ link.url }}"><span>{{ link.title }}</span></a>
						</li>
					{% endfor %}
				</ul>
			</div>
		</nav>
	</div>
</div>
<div class="site-footer__lower wrap flex spacious">
	<div class="site-footer__left flex spacious">
		<nav class="site-footer__policy-nav">
			<ul class="flex">
				{% for link in linklists.legal.links %}
					<li>
				      <a class="font:regular colour:base-white" href="{{ link.url }}"><span>{{ link.title }}</span></a>
					</li>
				{% endfor %}
			</ul>
		</nav>
	</div>
	<div class="site-footer__right">
		<p class="site-footer__copyright font:regular colour:base-white">2025 Dr. Christie Inc. All Rights Reserved.</p>
	</div>
	<a class="site-footer__logo mobile" href="{{ shop.url }}">
