<div id="{{ section.settings.large_headline
  | downcase
  | replace: ',', ''
  | replace: '.', ''
  | replace: '!', ''
  | replace: '?', ''
  | replace: ':', ''
  | replace: ';', ''
  | replace: "'", ''
  | replace: '"', ''
  | replace: '&', 'and'
  | replace: ' ', '-' 
}}" class="checkerboard:{{ section.settings.layout_alignment }} checkerboard:{{ section.settings.vertical_alignment }} flex">
	<article class="bg:base-white">
		<div class="checkerboard__content">
			{% if section.settings.headline != blank %}
				<h2 data-reveal class="uppercase text:eyebrow font:regular">{{ section.settings.headline }}</h2>
			{% endif %}

			{% if section.settings.large_headline != blank %}
				<p data-reveal class="font:fine text:heading-display">{{ section.settings.large_headline }}</p>
			{% endif %}

			{% if section.settings.copy != blank %}
				<div data-reveal class="copy font:regular text:body-m">
					{{ section.settings.copy }}
				</div>
			{% endif %}

			{% if section.settings.link_text != blank %}
				{% if section.settings.display_as_button_mobile == true %}
					<a data-reveal href="{{ section.settings.link }}" class="button colour:grey"><span class="font:medium uppercase text:cta-primary">{{ section.settings.link_text }}</span></a>
				{% endif %}
				<a data-reveal href="{{ section.settings.link }}" class="colour:grey font:regular underline text-link text:body-m {% if section.settings.display_as_button_mobile == true %}desktop{% endif %}">{{ section.settings.link_text }}</a>
			{% endif %}			
		</div>
	</article>
	<figure class="bg:base-white ar ar:checkerboard checkerboard:{{ section.settings.image_position }} {% if section.settings.hide_media_mobile == true %}hidden{% endif %}">
		{% if section.settings.video != blank %}
		    {{ section.settings.video | video_tag: image_size: '400x', loop: true, autoplay: true, muted: true }}
		{% else if section.settings.image != blank %}
			{% render 'lazy-image', img: section.settings.image, class: 'cover' %}
		{% endif %}
	</figure>
</div>

{% schema %}
{
  "name": "Checkerboard",
  "tag": "section",
  "class": "section checkerboard border:bottom__grey bg:grey",
  "settings": [
	  	{
	  		"type": "text",
	  		"id": "headline",
	  		"label": "Headline"	
	  	},
	  	{
	  		"type": "text",
	  		"id": "large_headline",
	  		"label": "Large Headline"	
	  	},
		{
			"type": "richtext",
			"id": "copy",
			"label": "Copy"
		},
		{
			"type": "text",
			"id": "link_text",
			"label": "Link Text"
		},
		{
			"type": "url",
			"id": "link",
			"label": "Link"
		},
		{
            "type": "select",
            "id": "layout_alignment",
            "label": "Layout Alignment",
            "default": "standard",
            "options": [
              {
                "value": "standard",
                "label": "Standard"
              },
              {
                "value": "reversed",
                "label": "Reversed"
              },
            ]
        },
       	{
            "type": "select",
            "id": "vertical_alignment",
            "label": "Vertical Alignment",
            "default": "top",
            "options": [
              {
                "value": "top",
                "label": "Top"
              },
              {
                "value": "bottom",
                "label": "Bottom"
              },
            ]
        },
		{
			"type": "video",
			"id": "video",
			"label": "Video (Takes precedence over image)"
		},
		{
			"type": "image_picker",
			"id": "image",
			"label": "Image"
		},
       	{
            "type": "select",
            "id": "image_position",
            "label": "Image Position",
            "default": "full-width",
            "options": [
              {
                "value": "full-width",
                "label": "Full Width & Height"
              },
              {
                "value": "framed",
                "label": "Framed"
              },
            ]
        },
		{
			"type": "checkbox",
			"id" : "hide_media_mobile",
			"label": "Hide Media On Mobile"
		},
		{
			"type": "checkbox",
			"id": "display_as_button_mobile",
			"label": "Display Link as Button On Mobile"
		}
	],
  "presets": [
	{
  		"name": "Checkerboard"
	}
  ]
}
{% endschema %}