<div data-reveal>
  {% if section.settings.content != blank %}
    <div class="text:body-l copy font:fine">{{ section.settings.content }}</div>
  {% endif %}
</div>

{% schema %}
{
  "name": "Insight Disclaimer",
  "tag": "section",
  "class": "section insight-disclaimer",
  "settings": [
    {
      "type": "richtext",
      "id": "content",
      "label": "Content"  
    }
	],
  "presets": [
	{
  		"name": "Insight Disclaimer"
	}
  ]
}
{% endschema %}