<header class="insight__header border:bottom__grey">

		<figure class="insight__header-image ar ar:insight-header">
			{% if section.settings.desktop_image != blank %}
				{% render 'lazy-image',
						img: section.settings.desktop_image,
						class: 'cover desktop'
					%}
			{% endif %}

			{% if section.settings.mobile_image != blank %}
				{% render 'lazy-image',
						img: section.settings.mobile_image,
						class: 'cover mobile'
					%}
			{% endif %}
		</figure>

		<div class="insight__header--content">
			<div class="insight__header--tags">
				<p data-reveal class="uppercase colour:grey text:eyebrow font:regular colour:base-white">{% for tag in article.tags %}
				  {{ tag }}{% unless forloop.last %}, {% endunless %}
				{% endfor %}</p>		
			</div>
				
			{% if article.title != blank %}
				<h1 data-reveal class="colour:grey font:fine text:heading-insight colour:base-white">{{ article.title }}</h1>
			{% endif %}

			<div class="flex spacious">
				<p data-reveal class="insight__header--date uppercase colour:grey text:eyebrow font:regular colour:base-white">{{ article.published_at | date: "%b %d, %Y" | upcase }}</p>
			</div>			
		</div>
</header>
<div class="insight__details">
	<div class="wrap">
		<div class="flex">
			{% if article.metafields.custom.credit.value != blank %}
					<p data-reveal class="font:regular colour:grey insight__header--credit colour:body">By: {{ article.author }}</p>
				{% endif %}

				{% if article.tags != blank %}
					<ul data-reveal class="insight__details--tags flex">
						{% for tag in article.tags %}
							<li class="colour:grey font:regular">
							  {{ tag }}{% unless forloop.last %}, {% endunless %}
							</li>
						{% endfor %}
					</ul>
				{% endif %}
		</div>
	</div>
</div>


{% schema %}
{
	"name": "Main Article",
	"tag": "section",
	"settings": [
		{
			"type": "image_picker",
			"id": "desktop_image",
			"label": "Desktop Image"
		},
		{
			"type": "image_picker",
			"id": "mobile_image",
			"label": "Mobile Image"
		}
	]
}
{% endschema %}