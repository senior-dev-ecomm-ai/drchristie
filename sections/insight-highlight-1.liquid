<div data-reveal class="bg:soft-lime">
  {% if section.settings.heading != blank %}
    <h2 class="font:regular colour:bordeaux">{{ section.settings.heading }}</h2>
  {% endif %}

  {% if section.settings.content != blank %}
    <div class="copy font:fine">{{ section.settings.content }}</div>
  {% endif %}
</div>

{% schema %}
{
  "name": "Insight Highlight 1",
  "tag": "section",
  "class": "section insight-highlight insight-highlight-1",
  "settings": [
	  {
	  	"type": "text",
	  	"id": "heading",
	  	"label": "Heading"	
	  },
    {
      "type": "richtext",
      "id": "content",
      "label": "Content"  
    }
	],
  "presets": [
	{
  		"name": "Insight Highlight 1"
	}
  ]
}
{% endschema %}