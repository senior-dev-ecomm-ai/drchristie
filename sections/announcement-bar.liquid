{% if section.settings.text != blank %}
	<div class="site-header__ticker site-header__ticker-wrapper bg:soft-lime">
		<div class="site-header__ticker-track">
			<div class="site-header__ticker-item colour:grey font:regular">{{ section.settings.text }}</div>
			<div class="site-header__ticker-item colour:grey font:regular" aria-hidden="true">{{ section.settings.text }}</div>
		</div>
	</div>
{% endif %}

{% style %}
	#shopify-section-{{ section.id }} {
		--announcement-menu-background: {{ section.settings.menu_background }};
		--announcement-menu-text: {{ section.settings.menu_text }};
	}
{% endstyle %}

{% stylesheet %}
	.site-header-group:has(.mega-nav__item.is-open) .site-header__ticker-wrapper {
		background: var(--announcement-menu-background, #580712);
		background-color: var(--announcement-menu-background, #580712);
	}

	.site-header-group:has(.mega-nav__item.is-open) .site-header__ticker-item,
	.site-header-group:has(.mega-nav__item.is-open) .site-header__ticker-item p {
		color: var(--announcement-menu-text, #FFFFFF);
	}
{% endstylesheet %}

{% schema %}
	{
	  "name": "Announcement bar",
	  "tag": "div",
	  "enabled_on": {
	    "groups": ["header"]
	  },
	  "settings": [
	    {
	      "type": "richtext",
	      "id": "text",
	      "label": "Text",
	      "default": "<p>Precision Medicine  |  Regenerative Aesthetics  |  Plastic Surgery</p>"
	    },
	    {
	      "type": "header",
	      "content": "Mega menu"
	    },
	    {
	      "type": "color",
	      "id": "menu_background",
	      "label": "Background",
	      "default": "#580712",
	      "info": "Used while the mega menu is open."
	    },
	    {
	      "type": "color",
	      "id": "menu_text",
	      "label": "Text",
	      "default": "#FFFFFF",
	      "info": "Used while the mega menu is open."
	    }
	  ],
	  "presets": [
	    {
	      "name": "Announcement bar"
	    }
	  ]
	}
{% endschema %}
