{% if section.settings.section_heading != blank %}
	<header class="wrap border:bottom__grey bg:base-white mobile">
		<h2 data-reveal class="font:fine text:heading-xl colour:grey">{{ section.settings.section_heading }}</h2>
	</header>
{% endif %}

<div class="two-column-media__wrapper bg:grey desktop">
	<figure class="ar bg:base-white two-column-media:{{ section.settings.vertical_alignment_left }}">
		{% if section.settings.video_left != blank %}
		    {{ section.settings.video_left | video_tag: image_size: '400x', loop: true, autoplay: true, muted: true }}
		{% else %}
			{% if section.settings.image_mobile_left != blank %}
				{% if section.settings.image_left != blank %}
					{% render 'lazy-image', img: section.settings.image_left, class: 'cover desktop' %}
				{% endif %}

				{% if section.settings.image_mobile_left != blank %}
					{% render 'lazy-image', img: section.settings.image_mobile_left, class: 'cover mobile' %}
				{% endif %}
			{% else %}
				{% if section.settings.image_left != blank %}
					{% render 'lazy-image', img: section.settings.image_left, class: 'cover' %}
				{% endif %}
			{% endif %}
		{% endif %}

		<figcaption>
			{% if section.settings.text_left_richtext != blank %}
				<div data-reveal class="font:fine colour:base-white text:heading-xl">{{ section.settings.text_left_richtext }}</div>
			{% endif %}

			{% if section.settings.small_text_left != blank %}
				<p data-reveal class="colour:base-white uppercase text:body-l font:regular">[{{ section.settings.small_text_left }}]</p>
			{% endif %}
		</figcaption>
	</figure>
	<figure class="ar bg:base-white two-column-media:{{ section.settings.vertical_alignment_right }}">
		{% if section.settings.video_right != blank %}
		    {{ section.settings.video_right | video_tag: image_size: '400x', loop: true, autoplay: true, muted: true }}
		{% else %}
			{% if section.settings.image_mobile_right != blank %}
				{% if section.settings.image_right != blank %}
					{% render 'lazy-image', img: section.settings.image_right, class: 'cover desktop' %}
				{% endif %}

				{% if section.settings.image_mobile_right != blank %}
					{% render 'lazy-image', img: section.settings.image_mobile_right, class: 'cover mobile' %}
				{% endif %}
			{% else %}
				{% if section.settings.image_right != blank %}
					{% render 'lazy-image', img: section.settings.image_right, class: 'cover' %}
				{% endif %}
			{% endif %}
		{% endif %}

		<figcaption>
			{% if section.settings.text_right_richtext %}
				<div data-reveal class="font:fine colour:base-white text:heading-xl">{{ section.settings.text_right_richtext }}</div>
			{% endif %}

			{% if section.settings.small_text_right != blank %}
				<p data-reveal class="colour:base-white uppercase text:body-l font:regular">[{{ section.settings.small_text_right }}]</p>
			{% endif %}
		</figcaption>
	</figure>
</div>

<div class="two-column-media-mobile mobile">
	<div class="swiper swiper-two-column-media two-column-media">
		<div class="swiper-wrapper">
			<div class="swiper-slide">
				<figure class="ar bg:base-white two-column-media:{{ section.settings.vertical_alignment_left }}">
					{% if section.settings.video_left != blank %}
					    {{ section.settings.video_left | video_tag: image_size: '400x', loop: true, autoplay: true, muted: true }}
					{% else %}
						{% if section.settings.image_mobile_left != blank %}
							{% if section.settings.image_left != blank %}
								{% render 'lazy-image', img: section.settings.image_left, class: 'cover desktop' %}
							{% endif %}

							{% if section.settings.image_mobile_left != blank %}
								{% render 'lazy-image', img: section.settings.image_mobile_left, class: 'cover mobile' %}
							{% endif %}
						{% else %}
							{% if section.settings.image_left != blank %}
								{% render 'lazy-image', img: section.settings.image_left, class: 'cover' %}
							{% endif %}
						{% endif %}
					{% endif %}

					<figcaption>
						{% if section.settings.text_left_richtext != blank %}
							<div data-reveal class="font:fine colour:base-white text:heading-xl">{{ section.settings.text_left_richtext }}</div>
						{% endif %}

						{% if section.settings.small_text_left != blank %}
							<p data-reveal class="colour:base-white uppercase text:body-l font:regular">[{{ section.settings.small_text_left }}]</p>
						{% endif %}
					</figcaption>
				</figure>
			</div>
			<div class="swiper-slide">
				<figure class="ar bg:base-white two-column-media:{{ section.settings.vertical_alignment_right }}">
					{% if section.settings.video_right != blank %}
					    {{ section.settings.video_right | video_tag: image_size: '400x', loop: true, autoplay: true, muted: true }}
					{% else %}
						{% if section.settings.image_mobile_right != blank %}
							{% if section.settings.image_right != blank %}
								{% render 'lazy-image', img: section.settings.image_right, class: 'cover desktop' %}
							{% endif %}

							{% if section.settings.image_mobile_right != blank %}
								{% render 'lazy-image', img: section.settings.image_mobile_right, class: 'cover mobile' %}
							{% endif %}
						{% else %}
							{% if section.settings.image_right != blank %}
								{% render 'lazy-image', img: section.settings.image_right, class: 'cover' %}
							{% endif %}
						{% endif %}
					{% endif %}

					<figcaption>
						{% if section.settings.text_right_richtext != blank %}
							<div data-reveal class="font:fine colour:base-white text:heading-xl">{{ section.settings.text_right_richtext }}</div>
						{% endif %}

						{% if section.settings.small_text_right != blank %}
							<p data-reveal class="colour:base-white uppercase text:body-l font:regular">[{{ section.settings.small_text_right }}]</p>
						{% endif %}
					</figcaption>
				</figure>
			</div>
		</div>
		<div class="swiper-pagination"></div>
	</div>
</div>
{% schema %}
{
  "name": "Two Column Media",
  "tag": "section",
  "class": "section two-column-media border:bottom__grey bg:grey",
  "settings": [
  		{
  			"type": "text",
  			"id": "section_heading",
  			"label": "Section Heading (Mobile Only)"
  		},
		{
            "type": "select",
            "id": "vertical_alignment_left",
            "label": "Layout Alignment",
            "default": "top",
            "options": [
              {
                "label": "Top",
                "value": "top"
              },
              {
                "value": "bottom",
                "label": "Bottom"
              },
            ]
        },
  		{
			"type": "video",
			"id": "video_left",
			"label": "Video (Takes precedence over image)"
		},
		{
			"type": "image_picker",
			"id": "image_left",
			"label": "Image"
		},
		{
			"type": "image_picker",
			"id": "image_mobile_left",
			"label": "Image (Optional Mobile Crop)"
		},
		{
            "type": "select",
            "id": "vertical_alignment_right",
            "label": "Layout Alignment",
            "default": "bottom",
            "options": [
              {
                "label": "Top",
                "value": "top"
              },
              {
                "value": "bottom",
                "label": "Bottom"
              },
            ]
        },
		{
			"type": "richtext",
			"id": "text_left_richtext",
			"label": "Text"
		},
		{
			"type": "text",
			"id": "small_text_left",
			"label": "Small Text"
		},
		{
			"type": "video",
			"id": "video_right",
			"label": "Video (Takes precedence over image)"
		},
		{
			"type": "image_picker",
			"id": "image_right",
			"label": "Image"
		},
		{
			"type": "image_picker",
			"id": "image_mobile_right",
			"label": "Image (Optional Mobile Crop)"
		},
		{
			"type": "richtext",
			"id": "text_right_richtext",
			"label": "Text"
		},
		{
			"type": "text",
			"id": "small_text_right",
			"label": "Small Text"
		}
	],
  "presets": [
	{
  		"name": "Two Column Media"
	}
  ]
}
{% endschema %}