{% if section.settings.overview_heading != blank %}
	<header class="wrap border:bottom__grey bg:base-white">
		<h2 data-reveal class="font:fine text:heading-xl colour:grey">{{ section.settings.overview_heading }}</h2>

		{% if section.settings.overview_subheading != blank %}
			<p data-reveal class="font:regular text:body-m">{{ section.settings.overview_subheading }}</p>
		{% endif %}
	</header>
{% endif %}

<div class="overview__wrap bg:grey">
	<article class="overview__copy bg:base-white">
		<div class="wrap">
			{% if section.settings.overview_headline_one != blank %}
				<header data-reveal>
					<h2 class="text:heading-m colour:bordeaux font:regular">{{ section.settings.overview_headline_one }}</h2>
				</header>
			{% endif %}

			{% if section.settings.overview_copy_one != blank %}
				<div data-reveal class="copy text:body-m font:regular">{{ section.settings.overview_copy_one }}</div>
			{% endif %}

			<a data-reveal href="/pages/inquiry" class="button colour:grey mobile"><span class="font:medium uppercase text:cta-primary">Get Started</span></a>
		</div>
	</article>
	<article class="overview__copy bg:base-white">
		<div class="wrap">
			{% if section.settings.overview_headline_two != blank %}
				<header data-reveal>
					<h2 class="text:heading-m colour:bordeaux font:regular">{{ section.settings.overview_headline_two }}</h2>
				</header>
			{% endif %}

			{% if section.settings.overview_copy_two != blank %}
				<div data-reveal class="copy text:body-m font:regular">{{ section.settings.overview_copy_two }}</div>
			{% endif %}

			<a data-reveal href="/pages/inquiry" class="button colour:grey mobile"><span class="font:medium uppercase text:cta-primary">Get Started</span></a>
		</div>
	</article>
	<figure class="ar bg:base-white">
		{% if section.settings.overview_image != blank %}
			{% render 'lazy-image', 
				img: section.settings.overview_image,
				class: 'cover'
			%}
		{% endif %}
	</figure>
</div>

{% schema %}
{
  "name": "Overview",
  "tag": "section",
  "class": "section overview border:bottom__grey",
  "settings": [
  		{
  			"type": "text",
  			"id": "overview_heading",
  			"label": "Section Heading"
  		},
  		{
  			"type": "text",
  			"id": "overview_subheading",
  			"label": "Section Subheading"			
  		},
  		{
	  		"type": "image_picker",
	  		"id": "overview_image",
	  		"label": "Overview Image"	
	  	},
	  	{
	  		"type": "text",
	  		"id": "overview_headline_one",
	  		"label": "Overview Headline (Left Column)"	
	  	},
		{
			"type": "richtext",
			"id": "overview_copy_one",
			"label": "Overview (Left Column)"
		},
	  	{
	  		"type": "text",
	  		"id": "overview_headline_two",
	  		"label": "Overview Headline (Right Column)"	
	  	},
		{
			"type": "richtext",
			"id": "overview_copy_two",
			"label": "Overview (Right Column)"
		}
	],
  "presets": [
	{
  		"name": "Overview"
	}
  ]
}
{% endschema %}
