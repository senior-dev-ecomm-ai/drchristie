{% style %}
	.site-header,
	.mega-menu__detail {
		--mega-font-1: {{ settings.mega_menu_font_family_1 | default: 'UntitledSansRegular' }}, sans-serif;
		--mega-size-1: {{ settings.mega_menu_font_size_1 | default: 16 }}px;
		--mega-font-2: {{ settings.mega_menu_font_family_2 | default: 'UntitledSansRegular' }}, sans-serif;
		--mega-size-2: {{ settings.mega_menu_font_size_2 | default: 14 }}px;
		--mega-font-3: {{ settings.mega_menu_font_family_3 | default: 'UntitledSansRegular' }}, sans-serif;
		--mega-size-3: {{ settings.mega_menu_font_size_3 | default: 14 }}px;
	}
{% endstyle %}

<div class="site-header__main bg:base-white">
	<div class="wrap flex spacious">
		<nav class="desktop">
			<button type="button" class="mega-nav__close" data-mega-close>
				<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 17 17" fill="none" aria-hidden="true"><path stroke="currentColor" stroke-width="1.083" d="m1 1 15 15m0-15L1 16"/></svg>
				<span class="visually-hidden">{{ 'header.close' | t }}</span>
			</button>
			<ul class="flex spacious">
				{% render 'nav-links', menu: section.settings.menu, blocks: section.blocks %}
			</ul>
			{% if linklists.clinic.links.size > 0 %}
				<div class="mega-nav__more">
					<p class="mega-nav__more-title colour:grey text:nav font:medium uppercase">{{ 'header.practice' | t }}</p>
					<ul>
						{% for link in linklists.clinic.links %}
							<li>
								<a class="colour:grey text:nav font:medium" href="{{ link.url }}"><span>{{ link.title }}</span></a>
							</li>
						{% endfor %}
					</ul>
					<a class="mega-nav__book colour:grey text:nav font:medium uppercase" href="/pages/contact">{{ 'header.book' | t }}</a>
				</div>
			{% endif %}
		</nav>

		<a href="#" class="navicon"></a>

		<a href="{{ shop.url }}" class="site-logo">
			<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 195 16" fill="none"><path fill="#66645E" d="M0 15.648V.352h6.923c4.849 0 8.028 2.88 8.028 7.584 0 4.747-3.243 7.712-8.156 7.712H0ZM6.519 2.912H2.7v10.176h3.818c4.232 0 5.689-2.4 5.689-5.11 0-2.709-1.468-5.066-5.69-5.066ZM20.973 15.648V.352h8.614c3.03 0 5.019 1.995 5.019 4.725 0 2.251-1.361 4.192-3.541 4.843l3.52 5.728h-3.19l-3.33-5.483h-4.391v5.483h-2.701Zm8.316-12.736h-5.615v4.725h5.423c1.542 0 2.776-.938 2.776-2.421 0-1.45-1.18-2.304-2.584-2.304ZM40.527 12.459h3.148v3.189h-3.148v-3.19ZM82.055 4.864l-2.605.565c-.532-1.898-2.36-2.901-4.785-2.901-3.52 0-5.658 2.144-5.658 5.504 0 3.435 2.223 5.44 5.605 5.44 2.648 0 4.413-1.216 4.86-3.285l2.668.618c-.69 3.2-3.53 5.195-7.635 5.195-4.976 0-8.241-2.933-8.241-7.883 0-5.013 3.36-8.117 8.369-8.117 3.85 0 6.71 1.824 7.422 4.864ZM90.745 9.237v6.411h-2.7V.352h2.7v6.325H99.7V.352h2.701v15.296h-2.7v-6.41h-8.955ZM108.531 15.648V.352h8.613c3.031 0 5.019 1.995 5.019 4.725 0 2.251-1.361 4.192-3.541 4.843l3.52 5.728h-3.19l-3.329-5.483h-4.391v5.483h-2.701Zm8.315-12.736h-5.614v4.725h5.423c1.542 0 2.775-.938 2.775-2.421 0-1.45-1.18-2.304-2.584-2.304ZM128.117 15.648V.352h2.701v15.296h-2.701ZM149.724 4.384l-2.627.608c-.446-1.675-1.903-2.592-4.253-2.592-2.053 0-3.499.704-3.499 2.112 0 1.685 2.053 1.952 4.349 2.25 2.957.385 6.37.822 6.37 4.331 0 3.19-2.85 4.907-6.508 4.907-3.732 0-6.614-1.792-7.337-4.928l2.722-.533c.51 2.037 2.244 3.072 4.743 3.072 2.201 0 3.647-.811 3.647-2.187 0-1.653-2.031-1.93-4.328-2.261-2.956-.427-6.391-.918-6.391-4.448 0-3.19 2.808-4.715 6.349-4.715 3.743 0 6.135 1.707 6.763 4.384ZM159.902 2.912h-6.221V.352h15.143v2.56h-6.221v12.736h-2.701V2.912ZM173.507 15.648V.352h2.701v15.296h-2.701ZM195 .352v2.56h-9.049v3.595h8.294v2.56h-8.294v4.021H195v2.56h-11.75V.352H195Z"/></svg>
		</a>

		<p>
			<a class="colour:grey text:nav font:medium uppercase desktop" href="/pages/contact">Book An Inquiry</a>
			<a class="colour:bordeaux text:nav font:regular flex mobile site-header__book" href="/pages/contact">Book</a>
			<a style="margin-left: 1.875rem;" href="/cart" class="desktop cart-link colour:grey text:nav font:medium uppercase">
			Cart (<span id="cart-count">{{ cart.item_count }}</span>)
			</a>
			<a style="margin-left: 1.875rem;" href="/cart" class="colour:bordeaux text:nav font:regular flex mobile">
			Cart (<span id="cart-count">{{ cart.item_count }}</span>)
			</a>
		</p>
	</div>	
</div>

<nav class="site-nav bg:bordeaux" aria-label="{{ 'header.menu' | t }}">
	<header class="wrap">
		<a href="#" class="site-nav__close">
			<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 17 17" fill="none" aria-hidden="true"><path stroke="#fff" stroke-width="1.083" d="m1 1 15 15m0-15L1 16"/></svg>
			<span class="visually-hidden">{{ 'header.close' | t }}</span>
		</a>
	</header>
	<div class="site-nav__wrapper">
		<div class="site-nav__section">
			<h2 class="colour:base-white uppercase text:heading-s font:medium wrap">{{ 'header.services' | t }}</h2>
			{% render 'site-nav-links', links: linklists.services.links, depth: 1, prefix: 'SiteNav-services' %}
		</div>
		<div class="site-nav__section">
			<h2 class="colour:base-white uppercase text:heading-s font:medium wrap">{{ 'header.practice' | t }}</h2>
			{% render 'site-nav-links', links: linklists.clinic.links, depth: 1, prefix: 'SiteNav-practice' %}
		</div>
	</div>
	<footer class="site-nav__footer bg:soft-lime">
		<div class="wrap">
			<a class="flex spacious" href="/pages/contact">
				<p class="colour:bordeaux font:regular text:heading-m">Book an Inquiry</p>
			</a>
		</div>
	</footer>
</nav>
<div class="site-nav__underlay">
	
</div>

{% stylesheet %}
	.mega-nav__item {
		position: static;
	}

	.mega-menu {
		--mega-pad: clamp(1.25rem, 3vw, 2.625rem);
		position: absolute;
		left: 0;
		right: 0;
		top: 100%;
		z-index: 8;
		display: grid;
		grid-template-rows: 0fr;
		background: #FDFBF5;
		border-top: 1px solid #000;
		max-height: var(--mega-available, 100dvh);
		pointer-events: none;
		visibility: hidden;
		transition: grid-template-rows 0.45s ease, visibility 0s linear 0.45s;
	}

	.mega-nav__item.is-open > .mega-menu {
		grid-template-rows: 1fr;
		height: var(--mega-available, calc(100dvh - 7.25rem));
		max-height: var(--mega-available, calc(100dvh - 7.25rem));
		overflow: hidden;
		pointer-events: auto;
		visibility: visible;
		transition: grid-template-rows 0.45s ease, visibility 0s linear 0s;
	}

	.mega-menu__clip {
		overflow: hidden;
		height: 100%;
		min-height: 0;
		max-height: 100%;
	}

	.mega-menu__panel {
		display: grid;
		grid-template-columns: minmax(0, 1fr);
		grid-template-rows: minmax(0, 1fr) auto;
		align-items: stretch;
		position: relative;
		container-type: inline-size;
		padding: 0;
		height: 100%;
		min-height: 0;
		max-height: 100%;
		overflow: hidden;
		background: #FDFBF5;
		border-bottom: 1px solid #66645e;
	}

	.mega-menu.is-drilled,
	.mega-menu.is-drilled .mega-menu__panel {
		background: var(--mega-selected-background, #FDFBF5);
		color: var(--mega-selected-text, #66645e);
	}

	.mega-menu.is-drilled .mega-menu__panel {
		grid-template-columns: minmax(0, 1fr);
		padding: 0;
		height: 100%;
		min-height: 0;
	}

	.mega-menu.is-drilled.is-split .mega-menu__panel {
		grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
	}

	.mega-menu__primary {
		display: flex;
		flex-direction: column;
		grid-row: 1;
		grid-column: 1;
		min-height: 0;
		height: 100%;
		padding: 0;
		overflow: auto;
	}

	.mega-menu.is-drilled .mega-menu__primary,
	.mega-menu.is-drilled .mega-menu__aside {
		width: 100%;
		min-width: 0;
	}

	.mega-menu.is-drilled .mega-menu__primary {
		padding: 0;
	}

	.mega-menu.is-drilled .mega-menu__aside {
		padding: 0;
	}

	.mega-menu__aside {
		display: none;
	}

	.mega-menu.is-drilled.is-split .mega-menu__aside {
		display: flex;
		flex-direction: column;
		grid-row: 1;
		grid-column: 2;
		position: relative;
		z-index: 6;
		min-height: 0;
		height: 100%;
	}

	.mega-menu.is-drilled .mega-menu__aside:has([data-mega-level="3"]) {
		align-self: end;
		height: calc(100% - 59px);
		min-height: 0;
		overflow: auto;
		background: var(--mega-selected-background, #FDFBF5);
		border-top: 1px solid #000;
		border-left: 1px solid #000;
	}

	.mega-menu__preview {
		position: absolute;
		top: 0;
		right: 0;
		width: 50vw;
		height: 100%;
		overflow: hidden;
		background: var(--mega-selected-background, #FDFBF5);
		opacity: 0;
		visibility: hidden;
		pointer-events: none;
		border-left: 1px solid #000;
		z-index: 8;
		transition: opacity 0.3s ease, visibility 0s linear 0.3s;
	}

	.mega-menu__preview.is-shown {
		opacity: 1;
		visibility: visible;
		transition: opacity 0.3s ease, visibility 0s linear 0s;
	}

	.mega-menu__preview-image {
		display: block;
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	.mega-menu__level {
		display: flex;
		flex-direction: column;
		gap: 0;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.mega-menu__item {
		margin: 0;
		padding: 0;
	}

	.mega-menu__level[hidden],
	.mega-menu__item[hidden],
	.mega-menu__back[hidden],
	.site-header__main nav.desktop .mega-menu .mega-menu__back[hidden] {
		display: none;
	}

	.mega-menu__level--nested {
		margin-top: 0;
	}

	.mega-menu__level[data-mega-level="3"] {
		padding: 0;
	}

	.mega-menu__index {
		display: inline-block;
		margin-right: 2.5rem;
		vertical-align: top;
		font-family: UntitledSansMedium, sans-serif;
		font-size: 11px;
		font-style: normal;
		letter-spacing: 0.04em;
		line-height: 1;
	}

	.mega-menu__link {
		color: #66645e;
		font-family: var(--mega-font-1, UntitledSansRegular, sans-serif);
		font-size: var(--mega-size-1, 16px);
		line-height: 1.3;
		text-decoration: none;
		display: inline-block;
		max-width: 100%;
		overflow-wrap: break-word;
	}

	.mega-menu__level[data-mega-level="1"] > .mega-menu__item > .mega-menu__link,
	.mega-menu__level[data-mega-level="2"] > .mega-menu__item > .mega-menu__link,
	.mega-menu__level[data-mega-level="3"] > .mega-menu__item > .mega-menu__link {
		display: block;
		position: relative;
		width: 100%;
		padding: 20px var(--mega-pad);
	}

	.mega-menu__level[data-mega-level="2"] > .mega-menu__item > .mega-menu__link {
		font-family: var(--mega-font-2, UntitledSansRegular, sans-serif);
		font-size: var(--mega-size-2, 14px);
		line-height: 0.8;
	}

	.mega-menu__level[data-mega-level="3"] > .mega-menu__item > .mega-menu__link {
		font-family: var(--mega-font-3, UntitledSansRegular, sans-serif);
		font-size: var(--mega-size-3, 14px);
		line-height: 0.8;
		padding-top: 18px;
		padding-bottom: 18px;
	}

	.mega-menu__level[data-mega-level="2"] > .mega-menu__item > .mega-menu__link {
		padding-left: calc(var(--mega-pad) + 6.5rem);
	}

	.site-header__main nav.desktop .mega-menu a::after {
		content: none;
		display: none;
	}

	.mega-menu__back::after,
	.site-header__main nav.desktop .mega-menu .mega-menu__level[data-mega-level="1"] > .mega-menu__item > .mega-menu__link::after,
	.site-header__main nav.desktop .mega-menu .mega-menu__level[data-mega-level="2"] > .mega-menu__item > .mega-menu__link::after,
	.site-header__main nav.desktop .mega-menu .mega-menu__level[data-mega-level="3"] > .mega-menu__item > .mega-menu__link::after {
		content: "";
		display: block;
		position: absolute;
		left: 0;
		bottom: 0;
		width: 100%;
		height: 0;
		border-bottom: 1px solid #000;
		pointer-events: none;
		z-index: 3;
	}

	.site-header__main nav.desktop .mega-menu .mega-menu__level[data-mega-level="3"] > .mega-menu__item > .mega-menu__link::after {
		width: 100%;
	}

	.site-header__main nav.desktop .mega-menu a:hover {
		color: #66645e;
	}

	.site-header__main nav.desktop .mega-menu .mega-menu__level[data-mega-level="1"] > .mega-menu__item > .mega-menu__link:hover,
	.site-header__main nav.desktop .mega-menu .mega-menu__level[data-mega-level="1"] > .mega-menu__item > .mega-menu__link:focus-visible {
		background: var(--item-hover-bg, #6E1616);
		color: var(--item-hover-text, #FFFFFF);
	}

	.site-header__main nav.desktop .mega-menu .mega-menu__level[data-mega-level="1"] > .mega-menu__item > .mega-menu__link:hover,
	.site-header__main nav.desktop .mega-menu .mega-menu__level[data-mega-level="1"] > .mega-menu__item > .mega-menu__link:focus-visible {
		font-style: italic;
	}

	.mega-menu__hover-meta {
		display: none;
	}

	.site-header__main nav.desktop .mega-menu .mega-menu__level[data-mega-level="1"] > .mega-menu__item > .mega-menu__link:hover .mega-menu__hover-meta,
	.site-header__main nav.desktop .mega-menu .mega-menu__level[data-mega-level="1"] > .mega-menu__item > .mega-menu__link:focus-visible .mega-menu__hover-meta {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 2.5rem;
		position: absolute;
		top: 0;
		right: 0;
		bottom: 0;
		width: 50vw;
		margin: 0;
		padding: 0 var(--mega-pad);
		font-style: normal;
	}

	.mega-menu__hover-description {
		max-width: 360px;
		font-family: UntitledSansRegular, sans-serif;
		font-size: 14px;
		font-weight: 400;
		font-style: normal;
		line-height: 130%;
	}

	.mega-menu__hover-cta {
		flex: 0 0 auto;
		margin-left: auto;
		font-family: UntitledSansRegular, sans-serif;
		font-size: 13px;
		font-weight: 400;
		font-style: normal;
		line-height: 1;
		white-space: nowrap;
		text-decoration: underline;
	}

	.site-header__main nav.desktop .mega-menu .mega-menu__level[data-mega-level="1"] > .mega-menu__item.is-selected > .mega-menu__link:hover .mega-menu__hover-meta,
	.site-header__main nav.desktop .mega-menu .mega-menu__level[data-mega-level="1"] > .mega-menu__item.is-selected > .mega-menu__link:focus-visible .mega-menu__hover-meta {
		display: none;
	}

	.site-header__main nav.desktop .mega-menu .mega-menu__level[data-mega-level="2"] > .mega-menu__item > .mega-menu__link:hover,
	.site-header__main nav.desktop .mega-menu .mega-menu__level[data-mega-level="2"] > .mega-menu__item > .mega-menu__link:focus-visible,
	.site-header__main nav.desktop .mega-menu .mega-menu__level[data-mega-level="2"] > .mega-menu__item.is-active > .mega-menu__link,
	.site-header__main nav.desktop .mega-menu .mega-menu__level[data-mega-level="3"] > .mega-menu__item > .mega-menu__link:hover,
	.site-header__main nav.desktop .mega-menu .mega-menu__level[data-mega-level="3"] > .mega-menu__item > .mega-menu__link:focus-visible {
		background: var(--item-child-hover-bg, #A4CED6);
		color: var(--item-child-hover-text, #66645E);
	}

	.mega-menu__level[data-mega-level="2"] > .mega-menu__item > .mega-menu__link:hover,
	.mega-menu__level[data-mega-level="2"] > .mega-menu__item > .mega-menu__link:focus-visible,
	.mega-menu__level[data-mega-level="2"] > .mega-menu__item.is-active > .mega-menu__link,
	.mega-menu__level[data-mega-level="3"] > .mega-menu__item > .mega-menu__link:hover,
	.mega-menu__level[data-mega-level="3"] > .mega-menu__item > .mega-menu__link:focus-visible,
	.mega-menu__level[data-mega-level="3"] > .mega-menu__item.is-active > .mega-menu__link {
		font-style: italic;
	}

	.site-header__main nav.desktop .mega-menu .mega-menu__level[data-mega-level="1"] > .mega-menu__item.is-selected > .mega-menu__link,
	.site-header__main nav.desktop .mega-menu .mega-menu__level[data-mega-level="1"] > .mega-menu__item.is-selected > .mega-menu__link:hover,
	.site-header__main nav.desktop .mega-menu .mega-menu__level[data-mega-level="1"] > .mega-menu__item.is-selected > .mega-menu__link:focus-visible {
		background: transparent;
		color: var(--item-hover-text, #FFFFFF);
		font-family: var(--mega-font-1, UntitledSansRegular, sans-serif);
		font-style: normal;
	}

	.mega-menu.is-drilled .mega-menu__link,
	.mega-menu.is-drilled .mega-menu__back {
		color: var(--mega-selected-text, #66645e);
	}

	.site-header__main nav.desktop .mega-menu .mega-menu__back {
		position: relative;
		width: 100%;
		margin: 0;
		height: 60px;
		min-height: 60px;
		flex: 0 0 60px;
		padding: 0 var(--mega-pad);
		border: 0;
		background: none;
		cursor: pointer;
		display: flex;
		align-items: center;
		gap: 0.65rem;
		text-align: left;
		font-family: UntitledSansMedium, sans-serif;
		font-size: 11px;
		line-height: 1;
	}

	.mega-menu__back-icon {
		display: block;
		width: 27px;
		height: auto;
		flex: none;
	}

	.mega-menu__back:hover {
		color: #580712;
	}

	.site-header__main nav.desktop .mega-menu .mega-menu__enquiry {
		display: flex;
		align-items: center;
		gap: 0.85rem;
		grid-row: 2;
		grid-column: 1 / -1;
		position: relative;
		z-index: 7;
		width: 100cqw;
		min-width: 0;
		height: 60px;
		min-height: 60px;
		margin: 0;
		padding: 0 var(--mega-pad);
		border-top: 1px solid #000;
		background: var(--mega-selected-background, #FDFBF5);
		color: #580712;
		font-family: UntitledSansRegular, sans-serif;
		font-size: 18px;
		font-weight: 400;
		font-style: normal;
		line-height: 1;
		letter-spacing: 0;
		text-align: left;
		text-transform: none;
		text-decoration: none;
	}

	.mega-menu__enquiry-icon {
		display: block;
		width: 36px;
		height: auto;
		flex: none;
		transform: scaleX(-1);
	}

	.site-header__main nav.desktop .mega-menu .mega-menu__enquiry:hover,
	.site-header__main nav.desktop .mega-menu .mega-menu__enquiry:focus-visible {
		background: #f1f4e2;
		color: #580712;
	}

	@media screen and (max-width: 859px) {
		html.has-treatment {
			overflow: hidden;
		}
	}

	.mega-menu__detail {
		--mega-pad: clamp(1.25rem, 3vw, 2.625rem);
		position: fixed;
		inset: 0;
		z-index: 1000;
		width: 100%;
		height: 100dvh;
		visibility: hidden;
		pointer-events: none;
		transition: visibility 0s linear 0.45s;
	}

	.mega-menu__detail.is-open {
		visibility: visible;
		pointer-events: auto;
		transition: visibility 0s linear 0s;
	}

	.mega-menu__detail-overlay {
		position: absolute;
		inset: 0;
		background: rgba(102, 100, 94, 0.45);
		opacity: 0;
		transition: opacity 0.45s ease;
	}

	.mega-menu__detail.is-open .mega-menu__detail-overlay {
		opacity: 1;
	}

	.mega-menu__detail-panel {
		position: absolute;
		top: 0;
		right: 0;
		width: 50%;
		height: 100dvh;
		background: var(--item-child-hover-bg, #A4CED6);
		color: var(--item-child-hover-text, #66645E);
		overflow: auto;
		opacity: 0;
		transition: opacity 0.45s ease;
	}

	.mega-menu__detail.is-open .mega-menu__detail-panel {
		opacity: 1;
	}

	.mega-menu__detail-head {
