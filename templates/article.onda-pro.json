    "insight_copy_section_JaApiq": {
      "type": "insight-copy-section",
      "name": "Insight Copy Section",
      "settings": {
        "large_headline": "What Treatment Is Like",
        "copy": "<p>Sessions last approximately 20 minutes. No numbing is required, though pre-treatment analgesia is recommended as heat accumulation toward the end of the session can become intense. Most patients tolerate this well. Results are visible immediately and continue to improve over the following weeks as the regenerative response matures.</p>"
      }
    },
    "insight_copy_section_a9Wtkq": {
      "type": "insight-copy-section",
      "name": "Insight Copy Section",
      "settings": {
        "large_headline": "What I Am Seeing Clinically",
        "copy": "<p>This technology is already changing how I approach certain cases. For patients with early skin laxity and good baseline health, strong nutrition, an active lifestyle, and minimal subcutaneous fat, I am achieving results I previously could only obtain in the operating room using subdermal energy devices under anesthesia. No recovery. No downtime. Better patient experience.</p><p>For this population specifically, OndaPro is not a compromise. It is, in many cases, the superior option.</p>"
      }
    },
