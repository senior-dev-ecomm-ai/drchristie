        "headline": "Plastic Surgery",
        "copy": "Enhancing your aesthetic goals with precision while honoring the features that make you unique.",
        "button_text": "Book An Inquiry",
        "button": "shopify://pages/contact",
        "layout_alignment": "left",
        "image": "shopify://shop_images/Mask_group_14.webp",
