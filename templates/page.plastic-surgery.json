    "accordion_34EhyW": {
      "type": "accordion",
      "blocks": {
        "slide_EXj8zL": {
          "type": "slide",
          "settings": {
            "accordion_item_heading": "Facial Rejuvenation",
            "accordion_item_content": "<p>Restorative procedures that address aging across skin, structure, and volume, blending regenerative therapies with surgical precision.</p><ul><li><strong>Non-Invasive Therapies: </strong>Skin-first regenerative treatments for radiance and tone</li><li><strong>Minimal-Access Face & Neck Surgery: </strong>Subtle enhancement with minimal downtime</li><li><strong>Minimal-Access Mid-Facelift: </strong>Targets early mid-face volume loss and sagging</li><li><strong>Facial Fat Transfer: </strong>Restores youthful contour using your own regenerative tissue</li><li><strong>Mini-Necklift: </strong>Precision lifting of the lower face and neck</li><li><strong>Facelift / Necklift:</strong> Comprehensive rejuvenation for structural harmony</li><li><strong>Upper Eyelid Surgery: </strong>Refreshes tired or hooded eyes</li><li><strong>Chin Augmentation: </strong>Refines balance and definition</li><li><strong>Facial Scar Optimization: </strong>Advanced techniques to minimize facial scarring</li></ul>"
          }
        },
        "slide_k8VgFm": {
          "type": "slide",
          "settings": {
            "accordion_item_heading": "Specialized Rejuvenation",
            "accordion_item_content": "<p>Targeted procedures to restore natural harmony and skin quality in commonly overlooked areas.</p><ul><li><strong>Ear Rejuvenation:</strong> Refines earlobe contour and volume</li><li><strong>Décolleté Rejuvenation: </strong>Improves tone, texture, and pigmentation</li><li><strong>Hand Rejuvenation: </strong>Restores volume and smooths aging hands</li><li><strong>Inner Thigh, Knee & Elbow Rejuvenation: </strong>Tightens, smooths, and refines crepey or sagging skin</li><li><strong>Customized Corrective Procedures: </strong>Tailored solutions for unique concerns.</li></ul>"
          }
        },
        "slide_xdhDjB": {
          "type": "slide",
          "settings": {
            "accordion_item_heading": "Breast Surgery",
            "accordion_item_content": "<p>Aesthetic and reconstructive procedures designed for symmetry, support, and long-term confidence.</p><ul><li><strong>Augmentation: </strong>Natural-looking enhancement with implants</li><li><strong>Breast Lift (Mastopexy): </strong>Restores shape and firmness</li><li><strong>Revision Surgery:</strong> Corrects or updates previous procedures</li><li><strong>Implant Maintenance: </strong>Ongoing care and optimization of implants</li><li><strong>Breast Cancer Reconstruction: </strong>Restorative options post-mastectomy</li><li><strong>Scar Optimization: </strong>Minimizes and improves appearance of surgical scars</li></ul>"
          }
        },
        "slide_f4NikA": {
          "type": "slide",
          "settings": {
            "accordion_item_heading": "Body Contouring & Surgery",
            "accordion_item_content": "<p>Precision reshaping and restoration for body confidence at every stage of life.</p><ul><li><strong>Mommy Makeover: </strong>Restorative, multi-area approach post-pregnancy</li><li><strong>Minimal-Access Abdominoplasty: </strong>Flattens and firms with umbilical preservation</li><li><strong>Corrective Body Contouring: </strong>Improves results from past procedures</li><li><strong>Body Contouring for Aging: </strong>Targets laxity and loss of definition over time</li><li><strong>Minimally Invasive Sculpting: </strong>Subtle reshaping with reduced downtime</li><li><strong>Upper Extremity Contouring: </strong>Addresses arms and upper body with finesse</li></ul>"
          }
        },
        "slide_GpMVTQ": {
          "type": "slide",
          "settings": {
            "accordion_item_heading": "Personal & Intimate Surgery",
            "accordion_item_content": "<p>Empowering, discreet procedures designed to restore comfort, function, and aesthetic confidence.</p><ul><li><strong>Comprehensive Vaginal Rejuvenation: </strong>Full-spectrum restoration of form and function</li><li><strong>Corrective Vaginal Rejuvenation: </strong>Addresses concerns from previous procedures</li><li><strong>Labiaplasty: </strong>Refines labial contour and symmetry</li><li><strong>Clitoral Hood Reduction: </strong>Enhances balance and sensitivity</li><li><strong>Perineal Skin Rejuvenation: </strong>Smooths and refines the perineal area</li><li><strong>Mini-Labiaplasty with Perineal Refinement: </strong>Subtle reshaping with soft tissue enhancement</li></ul>"
          }
        }
      },
