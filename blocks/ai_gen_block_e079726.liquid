{% doc %}
  @prompt
    Create a product grid section that displays all products from a selected collection with no product limit. The grid should have a clean, premium aesthetic with responsive columns showing product images, titles, and prices. Each product card must include a standard Shopify add-to-cart form (using action='/cart/add' and standard Shopify form conventions) with an Add to Cart button, so it is fully compatible with cart drawer apps like Essential Cart Drawer that intercept standard form submissions via AJAX. Include variant selection where applicable. No pagination — all products displayed at once.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-product-grid-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    padding: {{ block.settings.section_padding_top }}px 20px {{ block.settings.section_padding_bottom }}px;
    background-color: {{ block.settings.background_color }};
  }

  .ai-product-grid-container-{{ ai_gen_id }} {
    max-width: {{ block.settings.max_width }}px;
    margin: 0 auto;
  }

  .ai-product-grid-header-{{ ai_gen_id }} {
    text-align: {{ block.settings.heading_alignment }};
    margin-bottom: {{ block.settings.heading_spacing }}px;
  }

  .ai-product-grid-heading-{{ ai_gen_id }} {
    font-size: {{ block.settings.heading_size }}px;
    color: {{ block.settings.heading_color }};
    margin: 0;
    font-weight: 500;
    letter-spacing: 0.02em;
  }

  .ai-product-grid-items-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat({{ block.settings.columns_desktop }}, 1fr);
    gap: {{ block.settings.grid_gap }}px;
  }

  .ai-product-card-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    background-color: {{ block.settings.card_background }};
    border-radius: {{ block.settings.card_border_radius }}px;
    overflow: hidden;
    transition: transform 0.3s ease, box-shadow 0.3s ease;
  }

  .ai-product-card-{{ ai_gen_id }}:hover {
    transform: translateY(-4px);
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.08);
  }

  .ai-product-image-wrapper-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    padding-bottom: 100%;
    overflow: hidden;
    background-color: #f9f9f9;
  }

  .ai-product-image-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.3s ease;
  }

  .ai-product-card-{{ ai_gen_id }}:hover .ai-product-image-{{ ai_gen_id }} {
    transform: scale(1.05);
  }

  .ai-product-image-placeholder-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ai-product-image-placeholder-{{ ai_gen_id }} svg {
    width: 60%;
    height: 60%;
    opacity: 0.3;
  }

  .ai-product-info-{{ ai_gen_id }} {
    padding: {{ block.settings.card_padding }}px;
    display: flex;
    flex-direction: column;
    gap: 12px;
    flex-grow: 1;
  }

  .ai-product-title-{{ ai_gen_id }} {
    font-size: {{ block.settings.product_title_size }}px;
    color: {{ block.settings.product_title_color }};
    margin: 0;
    font-weight: 400;
    line-height: 1.4;
    text-decoration: none;
    display: block;
  }

  .ai-product-title-{{ ai_gen_id }}:hover {
    opacity: 0.7;
  }

  .ai-product-price-{{ ai_gen_id }} {
    font-size: {{ block.settings.product_price_size }}px;
    color: {{ block.settings.product_price_color }};
    font-weight: 500;
  }

  .ai-product-price-compare-{{ ai_gen_id }} {
    text-decoration: line-through;
    opacity: 0.6;
    margin-left: 8px;
    font-size: 0.9em;
  }

  .ai-product-variant-selector-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .ai-variant-label-{{ ai_gen_id }} {
    font-size: 13px;
    color: {{ block.settings.product_title_color }};
    font-weight: 500;
    margin: 0;
  }

  .ai-variant-select-{{ ai_gen_id }} {
    width: 100%;
    padding: 10px 12px;
    border: 1px solid #e0e0e0;
    border-radius: 4px;
    font-size: 14px;
    background-color: #ffffff;
    cursor: pointer;
    transition: border-color 0.2s ease;
  }

  .ai-variant-select-{{ ai_gen_id }}:hover {
    border-color: #c0c0c0;
  }

  .ai-variant-select-{{ ai_gen_id }}:focus {
    outline: 2px solid {{ block.settings.button_background }};
    outline-offset: 2px;
    border-color: {{ block.settings.button_background }};
  }

  .ai-add-to-cart-button-{{ ai_gen_id }} {
    width: 100%;
    padding: 14px 24px;
    background-color: {{ block.settings.button_background }};
    color: {{ block.settings.button_text_color }};
    border: none;
    border-radius: {{ block.settings.button_border_radius }}px;
    font-size: {{ block.settings.button_text_size }}px;
    font-weight: 500;
    cursor: pointer;
    transition: background-color 0.3s ease, transform 0.2s ease;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-top: auto;
  }

  .ai-add-to-cart-button-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.button_hover_background }};
    transform: translateY(-2px);
  }

  .ai-add-to-cart-button-{{ ai_gen_id }}:active {
    transform: translateY(0);
  }

  .ai-add-to-cart-button-{{ ai_gen_id }}:disabled {
    background-color: #e0e0e0;
    color: #999999;
    cursor: not-allowed;
    transform: none;
  }

  .ai-empty-state-{{ ai_gen_id }} {
    text-align: center;
    padding: 60px 20px;
    color: #666666;
  }

  .ai-empty-state-{{ ai_gen_id }} p {
    font-size: 16px;
    margin: 0;
  }

  @media screen and (max-width: 989px) {
    .ai-product-grid-items-{{ ai_gen_id }} {
      grid-template-columns: repeat({{ block.settings.columns_tablet }}, 1fr);
    }
  }

  @media screen and (max-width: 749px) {
    .ai-product-grid-items-{{ ai_gen_id }} {
      grid-template-columns: repeat({{ block.settings.columns_mobile }}, 1fr);
    }

    .ai-product-grid-heading-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.heading_size }}px * 0.8);
    }

    .ai-product-title-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.product_title_size }}px * 0.9);
    }
  }
{% endstyle %}

<product-grid-{{ ai_gen_id }} class="ai-product-grid-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-product-grid-container-{{ ai_gen_id }}">
    {% if block.settings.heading != blank %}
      <div class="ai-product-grid-header-{{ ai_gen_id }}">
        <h2 class="ai-product-grid-heading-{{ ai_gen_id }}">{{ block.settings.heading }}</h2>
      </div>
    {% endif %}

    {% if block.settings.collection != blank %}
      {% assign collection = block.settings.collection %}
      
      {% if collection.products.size > 0 %}
        <div class="ai-product-grid-items-{{ ai_gen_id }}">
          {% for product in collection.products %}
            <div class="ai-product-card-{{ ai_gen_id }}">
              <a href="{{ product.url }}" class="ai-product-image-wrapper-{{ ai_gen_id }}">
                {% if product.featured_image %}
                  <img
                    src="{{ product.featured_image | image_url: width: 800 }}"
                    alt="{{ product.featured_image.alt | escape }}"
                    loading="lazy"
                    width="800"
                    height="800"
                    class="ai-product-image-{{ ai_gen_id }}"
                  >
                {% else %}
                  <div class="ai-product-image-placeholder-{{ ai_gen_id }}">
                    {{ 'product-1' | placeholder_svg_tag }}
                  </div>
                {% endif %}
              </a>

              <div class="ai-product-info-{{ ai_gen_id }}">
                <a href="{{ product.url }}" class="ai-product-title-{{ ai_gen_id }}">
                  {{ product.title }}
                </a>

                <div class="ai-product-price-{{ ai_gen_id }}">
                  {{ product.price | money }}
                  {% if product.compare_at_price > product.price %}
                    <span class="ai-product-price-compare-{{ ai_gen_id }}">
                      {{ product.compare_at_price | money }}
                    </span>
                  {% endif %}
                </div>

                <form action="/cart/add" method="post" enctype="multipart/form-data" class="ai-product-form-{{ ai_gen_id }}">
                  {% if product.variants.size > 1 %}
                    <div class="ai-product-variant-selector-{{ ai_gen_id }}">
                      <label for="variant-{{ product.id }}-{{ ai_gen_id }}" class="ai-variant-label-{{ ai_gen_id }}">
                        {{ product.options_with_values[0].name }}
                      </label>
                      <select
                        id="variant-{{ product.id }}-{{ ai_gen_id }}"
                        name="id"
                        class="ai-variant-select-{{ ai_gen_id }}"
                        required
                      >
                        {% for variant in product.variants %}
                          <option
                            value="{{ variant.id }}"
                            {% unless variant.available %}disabled{% endunless %}
                          >
                            {{ variant.title }}
                            {% unless variant.available %} - Sold Out{% endunless %}
                          </option>
                        {% endfor %}
                      </select>
                    </div>
                  {% else %}
                    <input type="hidden" name="id" value="{{ product.variants.first.id }}">
                  {% endif %}

                  <button
                    type="submit"
                    class="ai-add-to-cart-button-{{ ai_gen_id }}"
                    {% unless product.available %}disabled{% endunless %}
                  >
                    {% if product.available %}
                      {{ block.settings.button_text }}
                    {% else %}
                      Sold Out
                    {% endif %}
                  </button>
                </form>
              </div>
            </div>
          {% endfor %}
        </div>
      {% else %}
        <div class="ai-empty-state-{{ ai_gen_id }}">
          <p>This collection is empty. Add products to display them here.</p>
        </div>
      {% endif %}
    {% else %}
      <div class="ai-empty-state-{{ ai_gen_id }}">
        <p>Select a collection to display products.</p>
      </div>
    {% endif %}
  </div>
</product-grid-{{ ai_gen_id }}>

<script>
  (function() {
    class ProductGrid{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        this.forms = this.querySelectorAll('.ai-product-form-{{ ai_gen_id }}');
        this.setupFormListeners();
      }

      setupFormListeners() {
        this.forms.forEach((form) => {
          const select = form.querySelector('.ai-variant-select-{{ ai_gen_id }}');
          const button = form.querySelector('.ai-add-to-cart-button-{{ ai_gen_id }}');

          if (select && button) {
            select.addEventListener('change', function() {
              const selectedOption = select.options[select.selectedIndex];
              const isAvailable = !selectedOption.disabled;
              
              button.disabled = !isAvailable;
              button.textContent = isAvailable ? '{{ block.settings.button_text }}' : 'Sold Out';
            });
          }
        });
      }
    }

    customElements.define('product-grid-{{ ai_gen_id }}', ProductGrid{{ ai_gen_id }});
  })();
</script>

{% schema %}
{
  "name": "Product grid",
  "settings": [
    {
      "type": "header",
      "content": "Collection"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
