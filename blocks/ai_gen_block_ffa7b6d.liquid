{% doc %}
  @prompt
    Create a skincare product grid that displays products from a selected collection with product image, title, and price. Each product card must include a clearly visible Add to Cart button using a standard Shopify cart form (form action="/cart/add") with a hidden input for the variant ID and a visible submit button. The button must always render and be clickable, compatible with third-party cart drawer apps like Essential Cart.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-product-grid-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    padding: {{ block.settings.section_padding }}px 0;
  }

  .ai-product-grid__heading-{{ ai_gen_id }} {
    text-align: {{ block.settings.heading_alignment }};
    font-size: {{ block.settings.heading_size }}px;
    color: {{ block.settings.heading_color }};
    margin: 0 0 {{ block.settings.heading_spacing }}px;
  }

  .ai-product-grid__container-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat({{ block.settings.columns_desktop }}, 1fr);
    gap: {{ block.settings.grid_gap }}px;
  }

  .ai-product-card-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    background-color: {{ block.settings.card_background }};
    border-radius: {{ block.settings.card_border_radius }}px;
    overflow: hidden;
    transition: transform 0.3s ease, box-shadow 0.3s ease;
  }

  .ai-product-card-{{ ai_gen_id }}:hover {
    transform: translateY(-4px);
    box-shadow: 0 8px 16px rgba(0, 0, 0, 0.1);
  }

  .ai-product-card__image-wrapper-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    padding-bottom: 100%;
    overflow: hidden;
    background-color: #f4f4f4;
  }

  .ai-product-card__image-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ai-product-card__image-placeholder-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: #f4f4f4;
  }

  .ai-product-card__image-placeholder-{{ ai_gen_id }} svg {
    width: 60%;
    height: 60%;
    opacity: 0.3;
  }

  .ai-product-card__content-{{ ai_gen_id }} {
    padding: {{ block.settings.card_padding }}px;
    display: flex;
    flex-direction: column;
    flex-grow: 1;
  }

  .ai-product-card__title-{{ ai_gen_id }} {
    font-size: {{ block.settings.title_size }}px;
    color: {{ block.settings.title_color }};
    margin: 0 0 8px;
    text-decoration: none;
    display: block;
  }

  .ai-product-card__title-{{ ai_gen_id }}:hover {
    opacity: 0.8;
  }

  .ai-product-card__price-{{ ai_gen_id }} {
    font-size: {{ block.settings.price_size }}px;
    color: {{ block.settings.price_color }};
    margin: 0 0 16px;
  }

  .ai-product-card__price--sale-{{ ai_gen_id }} {
    color: {{ block.settings.sale_price_color }};
  }

  .ai-product-card__price--compare-{{ ai_gen_id }} {
    text-decoration: line-through;
    opacity: 0.6;
    margin-left: 8px;
    font-size: {{ block.settings.price_size | times: 0.9 }}px;
  }

  .ai-product-card__form-{{ ai_gen_id }} {
    margin-top: auto;
  }

  .ai-product-card__add-to-cart-{{ ai_gen_id }} {
    width: 100%;
    padding: {{ block.settings.button_padding }}px;
    background-color: {{ block.settings.button_color }};
    color: {{ block.settings.button_text_color }};
    border: none;
    border-radius: {{ block.settings.button_border_radius }}px;
    font-size: {{ block.settings.button_text_size }}px;
    cursor: pointer;
    transition: background-color 0.3s ease;
  }

  .ai-product-card__add-to-cart-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.button_hover_color }};
  }

  .ai-product-card__add-to-cart-{{ ai_gen_id }}:disabled {
    background-color: {{ block.settings.button_disabled_color }};
    cursor: not-allowed;
    opacity: 0.6;
  }

  .ai-product-grid__empty-{{ ai_gen_id }} {
    text-align: center;
    padding: 60px 20px;
    color: #666;
    font-size: 16px;
  }

  @media screen and (max-width: 989px) {
    .ai-product-grid__container-{{ ai_gen_id }} {
      grid-template-columns: repeat({{ block.settings.columns_tablet }}, 1fr);
    }
  }

  @media screen and (max-width: 749px) {
    .ai-product-grid__container-{{ ai_gen_id }} {
      grid-template-columns: repeat({{ block.settings.columns_mobile }}, 1fr);
    }

    .ai-product-grid__heading-{{ ai_gen_id }} {
      font-size: {{ block.settings.heading_size | times: 0.8 }}px;
    }
  }
{% endstyle %}

<product-grid-{{ ai_gen_id }} class="ai-product-grid-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  {% if block.settings.heading != blank %}
    <h2 class="ai-product-grid__heading-{{ ai_gen_id }}">{{ block.settings.heading }}</h2>
  {% endif %}

  {% if block.settings.collection != blank %}
    {% assign collection = block.settings.collection %}
    {% assign products_to_show = block.settings.products_limit %}

    {% if collection.products.size > 0 %}
      <div class="ai-product-grid__container-{{ ai_gen_id }}">
        {% for product in collection.products limit: products_to_show %}
          <div class="ai-product-card-{{ ai_gen_id }}">
            <a href="{{ product.url }}" class="ai-product-card__image-wrapper-{{ ai_gen_id }}">
              {% if product.featured_image %}
                <img
                  src="{{ product.featured_image | image_url: width: 600 }}"
                  alt="{{ product.featured_image.alt | escape }}"
                  class="ai-product-card__image-{{ ai_gen_id }}"
                  loading="lazy"
                  width="600"
                  height="600"
                >
              {% else %}
                <div class="ai-product-card__image-placeholder-{{ ai_gen_id }}">
                  {{ 'product-1' | placeholder_svg_tag }}
                </div>
              {% endif %}
            </a>

            <div class="ai-product-card__content-{{ ai_gen_id }}">
              <a href="{{ product.url }}" class="ai-product-card__title-{{ ai_gen_id }}">
                {{ product.title }}
              </a>

              <div class="ai-product-card__price-{{ ai_gen_id }}">
                {% if product.compare_at_price > product.price %}
                  <span class="ai-product-card__price--sale-{{ ai_gen_id }}">
                    {{ product.price | money }}
                  </span>
                  <span class="ai-product-card__price--compare-{{ ai_gen_id }}">
                    {{ product.compare_at_price | money }}
                  </span>
                {% else %}
                  {{ product.price | money }}
                {% endif %}
              </div>

              <form action="/cart/add" method="post" class="ai-product-card__form-{{ ai_gen_id }}" enctype="multipart/form-data">
                <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">
                
                {% if product.available %}
                  <button
                    type="submit"
                    name="add"
                    class="ai-product-card__add-to-cart-{{ ai_gen_id }}"
                  >
                    {{ block.settings.button_text }}
                  </button>
                {% else %}
                  <button
                    type="button"
                    class="ai-product-card__add-to-cart-{{ ai_gen_id }}"
                    disabled
                  >
                    {{ block.settings.sold_out_text }}
                  </button>
                {% endif %}
              </form>
            </div>
          </div>
        {% endfor %}
      </div>
    {% else %}
      <div class="ai-product-grid__empty-{{ ai_gen_id }}">
        This collection is empty. Add products to see them here.
      </div>
    {% endif %}
  {% else %}
    <div class="ai-product-grid__empty-{{ ai_gen_id }}">
      Select a collection to display products
    </div>
  {% endif %}
</product-grid-{{ ai_gen_id }}>

<script>
  (function() {
    class ProductGrid{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        this.forms = this.querySelectorAll('.ai-product-card__form-{{ ai_gen_id }}');
        this.setupFormHandlers();
      }

      setupFormHandlers() {
        this.forms.forEach((form) => {
          form.addEventListener('submit', (event) => {
            const button = form.querySelector('.ai-product-card__add-to-cart-{{ ai_gen_id }}');
            if (button && !button.disabled) {
              button.disabled = true;
              button.textContent = 'Adding...';
              
              setTimeout(() => {
                button.disabled = false;
                button.textContent = '{{ block.settings.button_text }}';
              }, 2000);
            }
          });
        });
      }
    }

    customElements.define('product-grid-{{ ai_gen_id }}', ProductGrid{{ ai_gen_id }});
  })();
</script>

