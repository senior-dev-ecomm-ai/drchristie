{% doc %}
  @prompt
    Create a product grid section that displays all products from a selected collection with no product limit. The grid should have a clean, premium aesthetic with responsive columns showing product images, titles, and prices. Each product card must include a standard Shopify add-to-cart form using action='/cart/add' with method='post' and an input type='hidden' name='form_type' value='product' and type='hidden' name='utf8' value='✓'. Include a quantity input set to 1 and a variant ID hidden input. Add a visible Add to Cart button. Include variant selection dropdowns where applicable that update the hidden variant ID on change. After a successful add-to-cart, open the Essential Cart Drawer by doing all of the following: dispatch custom events essential:cart:open, essential:open:cart, essential:cart:toggle, cart:open, cart:toggle, cart:update, theme:cart:update on both document and window; call .open() or .toggle() on window.EssentialCartDrawer, window.ECD, window.essentialCartDrawer, window.CartDrawer if they exist; find and .click() the first matching element from [data-essential-cart-drawer], .essential-cart-drawer-trigger, .essential-cart-icon, [data-cart-drawer-trigger], .ecd-trigger, [aria-controls*="essential"]. Intercept the form submission via AJAX using fetch('/cart/add', { method: 'POST', body: new FormData(form) }) so the page does not reload. On success, trigger the drawer open sequence. Do not redirect to /cart. No pagination — all products displayed at once. No jQuery, no external dependencies. Output as a self-contained Shopify section file with schema.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-product-grid-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    padding: {{ block.settings.section_padding_top }}px 20px {{ block.settings.section_padding_bottom }}px;
    background-color: {{ block.settings.background_color }};
  }

  .ai-product-grid-container-{{ ai_gen_id }} {
    max-width: {{ block.settings.max_width }}px;
    margin: 0 auto;
  }

  .ai-product-grid-heading-{{ ai_gen_id }} {
    text-align: {{ block.settings.heading_alignment }};
    margin: 0 0 {{ block.settings.heading_spacing }}px;
    font-size: {{ block.settings.heading_size }}px;
    color: {{ block.settings.heading_color }};
    font-weight: 500;
    letter-spacing: 0.5px;
  }

  .ai-product-grid-items-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat({{ block.settings.columns_desktop }}, 1fr);
    gap: {{ block.settings.grid_gap }}px;
  }

  .ai-product-card-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    background-color: {{ block.settings.card_background }};
    border-radius: {{ block.settings.card_border_radius }}px;
    overflow: hidden;
    transition: transform 0.3s ease, box-shadow 0.3s ease;
  }

  .ai-product-card-{{ ai_gen_id }}:hover {
    transform: translateY(-4px);
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.08);
  }

  .ai-product-image-wrapper-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    padding-bottom: 100%;
    overflow: hidden;
    background-color: #f8f8f8;
  }

  .ai-product-image-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ai-product-info-{{ ai_gen_id }} {
    padding: {{ block.settings.card_padding }}px;
    display: flex;
    flex-direction: column;
    gap: 12px;
    flex-grow: 1;
  }

  .ai-product-title-{{ ai_gen_id }} {
    font-size: {{ block.settings.product_title_size }}px;
    color: {{ block.settings.product_title_color }};
    margin: 0;
    font-weight: 400;
    line-height: 1.4;
    letter-spacing: 0.3px;
  }

  .ai-product-title-link-{{ ai_gen_id }} {
    color: inherit;
    text-decoration: none;
  }

  .ai-product-title-link-{{ ai_gen_id }}:hover {
    opacity: 0.7;
  }

  .ai-product-price-{{ ai_gen_id }} {
    font-size: {{ block.settings.product_price_size }}px;
    color: {{ block.settings.product_price_color }};
    font-weight: 500;
  }

  .ai-product-form-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    gap: 10px;
    margin-top: auto;
  }

  .ai-variant-select-{{ ai_gen_id }} {
    width: 100%;
    padding: 10px 12px;
    border: 1px solid {{ block.settings.input_border_color }};
    border-radius: {{ block.settings.input_border_radius }}px;
    background-color: #ffffff;
    font-size: 14px;
    color: #333333;
    cursor: pointer;
  }

  .ai-quantity-wrapper-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .ai-quantity-label-{{ ai_gen_id }} {
    font-size: 14px;
    color: #666666;
  }

  .ai-quantity-input-{{ ai_gen_id }} {
    width: 60px;
    padding: 8px;
    border: 1px solid {{ block.settings.input_border_color }};
    border-radius: {{ block.settings.input_border_radius }}px;
    text-align: center;
    font-size: 14px;
  }

  .ai-add-to-cart-btn-{{ ai_gen_id }} {
    width: 100%;
    padding: {{ block.settings.button_padding }}px;
    background-color: {{ block.settings.button_color }};
    color: {{ block.settings.button_text_color }};
    border: none;
    border-radius: {{ block.settings.button_border_radius }}px;
    font-size: {{ block.settings.button_text_size }}px;
    font-weight: 500;
    cursor: pointer;
    transition: background-color 0.3s ease;
    letter-spacing: 0.5px;
    text-transform: uppercase;
  }

  .ai-add-to-cart-btn-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.button_hover_color }};
  }

  .ai-add-to-cart-btn-{{ ai_gen_id }}:disabled {
    opacity: 0.5;
    cursor: not-allowed;
  }

  .ai-empty-state-{{ ai_gen_id }} {
    text-align: center;
    padding: 60px 20px;
    color: #999999;
    font-size: 16px;
  }

  @media screen and (max-width: 989px) {
    .ai-product-grid-items-{{ ai_gen_id }} {
      grid-template-columns: repeat({{ block.settings.columns_tablet }}, 1fr);
    }
  }

  @media screen and (max-width: 749px) {
    .ai-product-grid-items-{{ ai_gen_id }} {
      grid-template-columns: repeat({{ block.settings.columns_mobile }}, 1fr);
    }

    .ai-product-grid-heading-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.heading_size }}px * 0.8);
    }
  }
{% endstyle %}

<product-grid-{{ ai_gen_id }} class="ai-product-grid-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-product-grid-container-{{ ai_gen_id }}">
    {% if block.settings.heading != blank %}
      <h2 class="ai-product-grid-heading-{{ ai_gen_id }}">{{ block.settings.heading }}</h2>
    {% endif %}

    {% if block.settings.collection != blank %}
      <div class="ai-product-grid-items-{{ ai_gen_id }}">
        {% for product in block.settings.collection.products %}
          <div class="ai-product-card-{{ ai_gen_id }}">
            <a href="{{ product.url }}" class="ai-product-image-wrapper-{{ ai_gen_id }}">
              {% if product.featured_image %}
                <img
                  src="{{ product.featured_image | image_url: width: 800 }}"
                  alt="{{ product.featured_image.alt | escape }}"
                  class="ai-product-image-{{ ai_gen_id }}"
                  loading="lazy"
                  width="800"
                  height="800"
                >
              {% else %}
                <div class="ai-product-image-{{ ai_gen_id }}" style="background-color: #f0f0f0;"></div>
              {% endif %}
            </a>

            <div class="ai-product-info-{{ ai_gen_id }}">
              <h3 class="ai-product-title-{{ ai_gen_id }}">
                <a href="{{ product.url }}" class="ai-product-title-link-{{ ai_gen_id }}">
                  {{ product.title }}
                </a>
              </h3>

              <div class="ai-product-price-{{ ai_gen_id }}">
                {{ product.price | money }}
              </div>

              <form action="/cart/add" method="post" class="ai-product-form-{{ ai_gen_id }}" data-product-form>
                <input type="hidden" name="form_type" value="product">
                <input type="hidden" name="utf8" value="✓">
                
                {% if product.variants.size > 1 %}
                  <select
                    name="id"
                    class="ai-variant-select-{{ ai_gen_id }}"
                    data-variant-select
                    required
                  >
                    {% for variant in product.variants %}
                      <option
                        value="{{ variant.id }}"
                        {% unless variant.available %}disabled{% endunless %}
                      >
                        {{ variant.title }}
                        {% unless variant.available %} - Sold Out{% endunless %}
                      </option>
                    {% endfor %}
                  </select>
                {% else %}
                  <input type="hidden" name="id" value="{{ product.variants.first.id }}">
                {% endif %}

                <div class="ai-quantity-wrapper-{{ ai_gen_id }}">
                  <label class="ai-quantity-label-{{ ai_gen_id }}" for="quantity-{{ product.id }}">Qty:</label>
                  <input
                    type="number"
                    id="quantity-{{ product.id }}"
                    name="quantity"
                    value="1"
                    min="1"
                    class="ai-quantity-input-{{ ai_gen_id }}"
                  >
                </div>

                <button
                  type="submit"
                  class="ai-add-to-cart-btn-{{ ai_gen_id }}"
                  {% unless product.available %}disabled{% endunless %}
                >
                  {% if product.available %}
                    {{ block.settings.button_text }}
                  {% else %}
                    Sold Out
                  {% endif %}
                </button>
              </form>
            </div>
          </div>
        {% endfor %}
      </div>
    {% else %}
      <div class="ai-empty-state-{{ ai_gen_id }}">
        Select a collection to display products
      </div>
    {% endif %}
  </div>
</product-grid-{{ ai_gen_id }}>

<script>
  (function() {
    class ProductGrid{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        this.forms = this.querySelectorAll('[data-product-form]');
        this.setupFormHandlers();
      }

      setupFormHandlers() {
        this.forms.forEach((form) => {
          form.addEventListener('submit', this.handleFormSubmit.bind(this));
        });
      }

      async handleFormSubmit(event) {
        event.preventDefault();
        
        const form = event.target;
        const button = form.querySelector('button[type="submit"]');
        const originalText = button.textContent;
        
        button.disabled = true;
        button.textContent = 'Adding...';

        try {
          const formData = new FormData(form);
          
          const response = await fetch('/cart/add', {
            method: 'POST',
            body: formData
          });

          if (response.ok) {
            await response.json();
            this.openCartDrawer();
            button.textContent = 'Added!';
            
            setTimeout(() => {
              button.disabled = false;
              button.textContent = originalText;
            }, 2000);
          } else {
            throw new Error('Failed to add to cart');
          }
        } catch (error) {
          console.error('Error adding to cart:', error);
          button.textContent = 'Error - Try Again';
          
          setTimeout(() => {
            button.disabled = false;
            button.textContent = originalText;
          }, 2000);
        }
      }

      openCartDrawer() {
        const eventNames = [
          'essential:cart:open',
          'essential:open:cart',
          'essential:cart:toggle',
          'cart:open',
          'cart:toggle',
          'cart:update',
          'theme:cart:update'
        ];

        eventNames.forEach((eventName) => {
          const event = new CustomEvent(eventName, { bubbles: true });
          document.dispatchEvent(event);
          window.dispatchEvent(event);
        });

        const drawerObjects = [
          window.EssentialCartDrawer,
          window.ECD,
          window.essentialCartDrawer,
          window.CartDrawer
        ];

        drawerObjects.forEach((drawer) => {
          if (drawer) {
            if (typeof drawer.open === 'function') {
              drawer.open();
            }
            if (typeof drawer.toggle === 'function') {
              drawer.toggle();
            }
          }
        });

        const selectors = [
          '[data-essential-cart-drawer]',
          '.essential-cart-drawer-trigger',
          '.essential-cart-icon',
          '[data-cart-drawer-trigger]',
          '.ecd-trigger',
          '[aria-controls*="essential"]'
        ];

        for (const selector of selectors) {
          const element = document.querySelector(selector);
          if (element) {
            element.click();
            break;
          }
        }
      }
    }

    customElements.define('product-grid-{{ ai_gen_id }}', ProductGrid{{ ai_gen_id }});
  })();
</script>

